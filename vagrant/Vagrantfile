# Requires:
# vagrant plugin install vagrant-disksize

# Branches to test, taken from the host environment. See provision-user.sh.
$branch_vars = ["REPO_BRANCH", "S2EENV_BRANCH", "LIBS2E_BRANCH", "SCRIPTS_BRANCH",
                "GUEST_IMAGES_BRANCH", "QEMU_BRANCH"]

# Debian 12, Debian 13, Ubuntu 24.04, Ubuntu 26.04
$boxes = ["debian/bookworm64", "debian/trixie64", "bento/ubuntu-24.04", "cloud-image/ubuntu-26.04"]

# Root disk sizes in GB for boxes whose root disk is too small. Podman stores its
# images in the home directory, so the root disk must hold the multi-gigabyte
# build images. vagrant-libvirt grows the disk when it creates the VM, and
# cloud-init in the image grows the root partition and file system at boot.
$root_disk_sizes = { "cloud-image/ubuntu-26.04" => 40 }

Vagrant.configure("2") do |config|
  $boxes.to_enum.with_index(1).each do |box,i|
    config.vm.define "s2e_machine_#{i}" do |node|
      node.vm.box = box
      node.vm.synced_folder ".", "/vagrant", type: "rsync"
      node.vm.provision :shell do |s|
        s.path = "provision-root.sh"
        s.env = $branch_vars.select { |v| ENV[v] }.to_h { |v| [v, ENV[v]] }
      end

      node.ssh.forward_agent = true
      node.ssh.forward_x11 = true

      node.vm.provider :libvirt do |v|
        v.cpus = 16
        v.memory = 16384
        v.storage :file, :size => '100G'
        if $root_disk_sizes[box]
          v.machine_virtual_size = $root_disk_sizes[box]
        end
      end
    end
  end
end
